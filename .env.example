# GlassOS Generator Environment Configuration Example
# Copy this file to .env (which is ignored by git) to provide API keys locally.

# Google Gemini API Key (Priority 1 in Cascade)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=

# 9Router / OpenAI-Compatible Gateway Token (Priority 2 in Cascade)
ROUTER_API_KEY=
