# GlassOS Generator Environment Configuration Example
# Copy this file to .env (which is ignored by git) to provide API keys locally.

# Google Gemini API Key (Priority 1 in Cascade)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=

# 9Router / Local Gateway Token (Priority 2 in Cascade)
# If using localhost:20128, this key is optional or can be any dummy token
ROUTER_API_KEY=

# TokenRouter API Key (Priority 3 in Cascade)
# Endpoint: https://api.tokenrouter.com/v1
TOKENROUTER_API_KEY=
