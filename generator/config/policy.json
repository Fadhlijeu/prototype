{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Autonomous Generator System Policy",
  "version": "1.0.0",
  "description": "Hard governance constraints for autonomous and assisted Glass UI generation in the design system",
  "hard_constraints": {
    "family": "glass",
    "theme": "dark",
    "styling_standard": "vanilla_css_with_tokens",
    "master_token_path": "../css.css",
    "forbidden_libraries": [
      "tailwindcss",
      "bootstrap",
      "jquery",
      "font-awesome",
      "material-ui"
    ],
    "allowed_icon_provider": "lucide",
    "max_file_size_bytes": 102400,
    "max_pending_queue_size": 100
  },
  "quality_rules": {
    "semantic_html": true,
    "require_aria_labels": true,
    "require_reduced_motion_media_query": true,
    "require_glass_specular_border": true,
    "require_focus_visible": true,
    "no_inline_event_handlers": true
  },
  "output_structure": {
    "standalone_demo": "index.html",
    "component_css": "index.css",
    "component_js": "index.js",
    "raw_bundle": "{slug}.html",
    "metadata_manifest": "manifest.json"
  }
}
